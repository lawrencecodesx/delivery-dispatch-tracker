DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/delivery_dispatch
JWT_SECRET_KEY=replace_with_a_random_value_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
APP_ENV=development
ALLOW_PUBLIC_ROLE_REGISTRATION=false